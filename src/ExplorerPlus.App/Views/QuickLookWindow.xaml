<Window x:Class="ExplorerPlus.App.Views.QuickLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ExplorerPlus.App.Views"
        Title="Quick Look - Explorer+" Width="900" Height="640" MinWidth="320" MinHeight="240"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="{Binding Message}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding ShowMessage, Converter={StaticResource BoolToVis}}" />
            <Image Source="{Binding PreviewImage}" Margin="16" Stretch="Uniform" StretchDirection="DownOnly"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding ShowImage, Converter={StaticResource BoolToVis}}" />
            <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="14,10" BorderThickness="0" Background="Transparent"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}" />
            <views:PreviewHost x:Name="Host" Visibility="{Binding ShowHandler, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="14,8">
            <DockPanel>
                <Image x:Name="InfoIcon" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="Space or Esc to close · arrows to move" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="InfoName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="InfoDetails" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
