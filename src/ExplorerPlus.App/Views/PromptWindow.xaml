<Window x:Class="ExplorerPlus.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="24,16,24,20">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBox x:Name="Input" VerticalContentAlignment="Center" TextChanged="OnInputChanged"
                 AutomationProperties.LabeledBy="{Binding ElementName=Message}" />
        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="96" IsCancel="True" Margin="8,0,0,0" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" MinWidth="96" IsDefault="True" Click="OnOkClick"
                    Style="{StaticResource AccentButtonStyle}" />
        </DockPanel>
    </StackPanel>
</Window>
