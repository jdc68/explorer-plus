<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- Built by installer/build.ps1, which publishes the app first and passes PublishDir and ProductVersion. -->
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <OutputName>ExplorerPlus-$(ProductVersion)-$(Platform)</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir);IconFile=$(MSBuildThisFileDirectory)..\src\ExplorerPlus.App\Assets\ExplorerPlus.ico</DefineConstants>
    <!-- Per-user install under %LocalAppData%\Programs: these ICEs assume per-machine folders. -->
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
    <!-- The solution-wide C# settings don't apply here. -->
    <TargetFramework></TargetFramework>
    <Nullable></Nullable>
    <ImplicitUsings></ImplicitUsings>
  </PropertyGroup>

</Project>
