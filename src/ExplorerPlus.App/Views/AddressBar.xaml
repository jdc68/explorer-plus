<UserControl x:Class="ExplorerPlus.App.Views.AddressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ExplorerPlus.App.Views">
    <UserControl.Resources>
        <Style x:Key="CrumbButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChevronButton" TargetType="Button" BasedOn="{StaticResource CrumbButton}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="Frame" BorderThickness="1" CornerRadius="4" MinHeight="32"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <DockPanel x:Name="CrumbView" Background="Transparent" MouseLeftButtonUp="OnCrumbAreaClick" LastChildFill="True">
                    <Image DockPanel.Dock="Left" Source="{Binding SelectedTab.Icon}" Width="16" Height="16" Margin="8,0,2,0"
                           VerticalAlignment="Center" />
                    <ItemsControl x:Name="Crumbs" ItemsSource="{Binding SelectedTab.Breadcrumb}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Address"
                                  HorizontalAlignment="Left" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:BreadcrumbPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource CrumbButton}" Content="{Binding Name}"
                                            Click="OnSegmentClick" MouseUp="OnSegmentMouseUp" ToolTip="{Binding Location.EditText}" />
                                    <Button Style="{StaticResource ChevronButton}" Content="&#xE76C;" Click="OnChevronClick"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Folders in {0}'}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <TextBox x:Name="Editor" Visibility="Collapsed" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Address"
                         VerticalContentAlignment="Center" Padding="8,0" MinHeight="30"
                         PreviewKeyDown="OnEditorKeyDown" LostKeyboardFocus="OnEditorLostFocus" TextChanged="OnEditorTextChanged" />
            </Grid>
        </Border>

        <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=Frame}" Placement="Bottom"
               StaysOpen="True" AllowsTransparency="True" Focusable="False">
            <Border CornerRadius="6" BorderThickness="1" Padding="2" Margin="0,2,0,0"
                    MinWidth="{Binding ActualWidth, ElementName=Frame}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <ListBox x:Name="SuggestionList" MaxHeight="320" BorderThickness="0" Focusable="False" AutomationProperties.Name="Suggestions"
                         PreviewMouseLeftButtonUp="OnSuggestionClick" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
