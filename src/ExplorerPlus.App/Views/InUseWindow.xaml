<Window x:Class="ExplorerPlus.App.Views.InUseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What is using this? - Explorer+" Width="640" Height="420" MinWidth="480" MinHeight="300"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="Summary" Grid.Row="1" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- The Fluent theme has no GridView styles; borrow the file list's. -->
        <ListView x:Name="Holders" Grid.Row="2" AutomationProperties.Name="Apps using it"
                  Style="{StaticResource FileListStyle}" ItemContainerStyle="{StaticResource FileRowBaseStyle}"
                  BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="App" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Process ID" Width="90" DisplayMemberBinding="{Binding ProcessId}" />
                    <GridViewColumn Header="" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Content="Close" Padding="12,2" MinHeight="24" HorizontalAlignment="Left" Click="OnCloseAppClick"
                                            Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Asks the app to close, so it can save first"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Close {0}}" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="RefreshButton" DockPanel.Dock="Left" Content="Refresh" MinWidth="96" Click="OnRefreshClick" />
            <Button DockPanel.Dock="Right" Content="Close" MinWidth="96" IsCancel="True" Margin="8,0,0,0" />
            <Button x:Name="TryAgainButton" DockPanel.Dock="Right" Content="Try again" MinWidth="96" Margin="8,0,0,0" Click="OnTryAgainClick"
                    Visibility="Collapsed" />
            <Button x:Name="ForceDeleteButton" DockPanel.Dock="Right" Content="Force delete" MinWidth="96" Click="OnForceDeleteClick"
                    Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
        </DockPanel>
    </Grid>
</Window>
