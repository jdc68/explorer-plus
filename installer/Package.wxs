<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Per-user MSI: installs to %LocalAppData%\Programs\Explorer+ without admin rights, adds a Start menu shortcut with
    the app's AppUserModelID (so the taskbar button and jump list group with it), and on uninstall gives folders back to
    File Explorer if Explorer+ was made the default file manager.
  -->
  <Package Name="Explorer+" Manufacturer="Denis Cernat" Version="$(var.ProductVersion)"
           UpgradeCode="1727c5fb-2cab-40f9-8972-682d1585ca16" Scope="perUser" Compressed="yes" InstallerVersion="500">

    <!-- A rebuild with the same version still replaces the installed copy instead of installing next to it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Explorer+ is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Explorer+" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
      <Component Id="InstallFolderCleanup" Guid="3d1d3b1e-63d6-4b0a-9a7e-2f1f4f0e9b21">
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\ExplorerPlus\Install" Name="Path" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <!--
          The "default file manager" keys, deleted by Windows Installer itself on uninstall, as a safety net in case the
          custom action below fails. With these keys gone, a Directory\shell default left pointing at ExplorerPlus.open
          names a verb that no longer exists, and Windows falls back to File Explorer (checked by hand).
        -->
        <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\ExplorerPlus.open" ForceDeleteOnUninstall="yes" />
        <RegistryKey Root="HKCU" Key="Software\Classes\Drive\shell\ExplorerPlus.open" ForceDeleteOnUninstall="yes" />
        <RegistryKey Root="HKCU" Key="Software\Classes\CLSID\{52205fd8-5dfb-447d-801a-d0b52f2e83e1}\shell\opennewwindow\command" ForceDeleteOnUninstall="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="9b7c0b1e-2f5a-4d43-8f0e-6a4b5d2c1e77">
        <Shortcut Id="AppShortcut" Name="Explorer+" Description="A fast file manager for Windows"
                  Target="[INSTALLFOLDER]ExplorerPlus.exe" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="ExplorerPlus" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\ExplorerPlus\Install" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!--
      Before the files go (uninstall, and the old version's removal during an upgrade): Explorer+ may be running in the
      background with no window, so ask it to exit and wait for it, rather than leave locked files for a reboot.
    -->
    <CustomAction Id="QuitRunning" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]ExplorerPlus.exe&quot; --quit"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <!--
      On uninstall (not on upgrade), undo the "default file manager" switch while the exe is still there, which also
      puts back what another file manager had set before, and remove the sign-in entry. Runs after
      RemoveRegistryValues has deleted the keys above.
    -->
    <CustomAction Id="UnregisterDefault" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]ExplorerPlus.exe&quot; --uninstall"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <!-- After install or upgrade: start in the background so folders open instantly right away (exits at once when
         that is turned off in Settings). NOSTART=1 skips it (build.ps1 -NoStart, for installs run from a sandboxed shell). -->
    <CustomAction Id="StartInBackground" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]ExplorerPlus.exe&quot; --background"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="StartInBackground" After="InstallFinalize" Condition="NOT REMOVE AND NOT NOSTART" />
      <Custom Action="QuitRunning" Before="UnregisterDefault" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="UnregisterDefault" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Explorer+">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
