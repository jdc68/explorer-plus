<Window x:Class="ExplorerPlus.App.Views.DiskUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ExplorerPlus.App.Views"
        Title="Disk usage - Explorer+" Width="1180" Height="740" MinWidth="680" MinHeight="420"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <Grid Margin="12,8,12,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <Button x:Name="UpButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE74A;" Click="OnUpClick"
                    ToolTip="Up a level (Backspace)" AutomationProperties.Name="Up" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="TreemapButton" Style="{StaticResource RecentToggle}" Content="Treemap" Click="OnChartClick" />
                <ToggleButton x:Name="SunburstButton" Style="{StaticResource RecentToggle}" Content="Sunburst" Click="OnChartClick" />
            </StackPanel>
            <ItemsControl x:Name="Crumbs" VerticalAlignment="Center" Margin="4,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="2,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Button Style="{StaticResource CommandButton}" Content="{Binding Name}" Tag="{Binding}" Click="OnCrumbClick" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <WrapPanel x:Name="Legend" Grid.Row="1" Margin="0,4,0,6" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="380" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="ChartHost" Grid.Column="0" ClipToBounds="True">
                <views:TreemapView x:Name="Treemap" AutomationProperties.Name="Treemap" />
                <views:SunburstView x:Name="Sunburst" AutomationProperties.Name="Sunburst" Visibility="Collapsed" />
            </Grid>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />
            <!-- The Fluent theme has no GridView styles; borrow the file list's. -->
            <ListView x:Name="Rows" Grid.Column="2" AutomationProperties.Name="Items by size"
                      Style="{StaticResource FileListStyle}" ItemContainerStyle="{StaticResource FileRowBaseStyle}" SelectionMode="Single"
                      BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      SelectionChanged="OnRowSelected" MouseDoubleClick="OnRowDoubleClick" ContextMenuOpening="OnRowMenu" KeyDown="OnRowKeyDown">
                <ListView.ContextMenu>
                    <ContextMenu />
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" Width="84">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Right" MinWidth="70" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Share" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="76" Height="14">
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="2" />
                                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BarWidth}" />
                                        <TextBlock Text="{Binding ShareText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="3" Margin="2,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
