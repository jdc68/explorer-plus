<Window x:Class="ExplorerPlus.App.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare folders - Explorer+" Width="1000" Height="680" MinWidth="680" MinHeight="440"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Right" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Compare folders" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" AutomationProperties.HeadingLevel="Level1" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="LeftLabel" Text="Left" Style="{StaticResource Label}" />
            <TextBox x:Name="LeftBox" Grid.Column="1" KeyDown="OnPathKeyDown" AutomationProperties.LabeledBy="{Binding ElementName=LeftLabel}" />
            <Button Grid.Column="2" Content="Browse…" Margin="8,4,0,4" Click="OnBrowseLeft" />
            <TextBlock x:Name="RightLabel" Grid.Row="1" Text="Right" Style="{StaticResource Label}" />
            <TextBox x:Name="RightBox" Grid.Row="1" Grid.Column="1" KeyDown="OnPathKeyDown" AutomationProperties.LabeledBy="{Binding ElementName=RightLabel}" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="8,4,0,4" Click="OnBrowseRight" />
            <Button Grid.Column="3" Grid.RowSpan="2" Margin="8,4,0,4" VerticalAlignment="Stretch" Click="OnSwap"
                    ToolTip="Swap the folders" AutomationProperties.Name="Swap the folders">
                <TextBlock Text="&#xE8AB;" FontFamily="{DynamicResource IconFont}" />
            </Button>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
            <CheckBox x:Name="ContentBox" Content="Compare contents" Click="OnCompareClick"
                      ToolTip="Read files of the same size to tell whether they really match. Slower, but finds changes that kept the size and date." />
            <CheckBox x:Name="SameBox" Content="Show identical files" Click="OnFilterChanged" />
            <Button x:Name="CompareButton" Content="Compare" MinWidth="96" Click="OnCompareClick" />
        </WrapPanel>

        <!-- The Fluent theme has no GridView styles; borrow the file list's. -->
        <ListView x:Name="Results" Grid.Row="3" Margin="0,12,0,0" AutomationProperties.Name="Differences"
                  Style="{StaticResource FileListStyle}" ItemContainerStyle="{StaticResource FileRowBaseStyle}"
                  BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Name" Width="330">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Left size" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftSize}" Style="{StaticResource Right}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Left modified" Width="140" DisplayMemberBinding="{Binding LeftModified}" />
                    <GridViewColumn Header="Right size" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightSize}" Style="{StaticResource Right}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Right modified" Width="140" DisplayMemberBinding="{Binding RightModified}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel>
                <TextBlock x:Name="DirectionLabel" Text="Sync" Style="{StaticResource Label}" />
                <ComboBox x:Name="DirectionBox" MinWidth="300" SelectedIndex="0" SelectionChanged="OnFilterChanged" Margin="0,0,20,0"
                          AutomationProperties.LabeledBy="{Binding ElementName=DirectionLabel}">
                    <ComboBoxItem Content="Left to right (right becomes a copy)" />
                    <ComboBoxItem Content="Right to left (left becomes a copy)" />
                    <ComboBoxItem Content="Both ways (newer file wins)" />
                </ComboBox>
                <CheckBox x:Name="ExtrasBox" Content="Remove items that are only in the target" Click="OnFilterChanged"
                          ToolTip="They go to the Recycle Bin, so the target ends up with exactly the source's files." />
            </WrapPanel>
            <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Close" MinWidth="96" IsCancel="True" Margin="8,0,0,0" />
                <Button x:Name="SyncButton" DockPanel.Dock="Right" Content="Sync" MinWidth="96" IsEnabled="False" Click="OnSyncClick"
                        Style="{StaticResource AccentButtonStyle}" />
                <TextBlock x:Name="Summary" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
